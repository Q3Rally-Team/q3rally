{
	cull disable
	surfaceparm trans
	surfaceparm alphashadow

	{
		map textures/q3r_trees/pinetrim02a.tga
		blendFunc blend
		alphaFunc GE128
		depthWrite
		rgbGen identity
	}
	{
		map $lightmap
		rgbGen identity
		blendFunc GL_DST_COLOR GL_ZERO
		depthFunc equal
	}
}

