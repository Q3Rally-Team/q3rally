{
	qer_trans .5
	surfaceparm trans
	//surfaceparm solid
	cull disable
    {
        map textures/effects/tinfx.tga
        tcgen environment
        blendfunc gl_one gl_one
        rgbGen identity
    }
    {
        map $lightmap
        blendFunc gl_dst_color gl_zero
        rgbgen identity
    }
}

