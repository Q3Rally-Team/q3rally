// ------------------------------------------------------------
// 305.dip_valley (water)
// ------------------------------------------------------------

textures/dip_valley/water
{
	qer_editorimage textures/dip_valley/water2.tga
	surfaceparm nonsolid
	surfaceparm trans
	surfaceparm water
	cull disable
	deformVertexes wave 64 sin 0.5 0.5 0 0.5 
	qer_trans 0.5
	q3map_globaltexture
	// OpenGL2: rippled real-time reflection (the stages below are the
	// OpenGL1 / r_water 0 look)
	q3r_water textures/q3r_liquids/water_normal.tga 320 0.03 0.03
	q3r_waterColor 0.05 0.11 0.20 0.65
	q3r_waterFresnel 0.12 4
	q3r_waterSpecular 0.8
	{
		map textures/dip_valley/water1.tga
		blendfunc blend
		rgbGen identity
		tcMod scroll 0.01 0.02
		tcMod scale 0.5 0.5
	}
	{
		map textures/dip_valley/water1.tga
		blendfunc blend
		rgbGen identity
		tcMod scroll -0.01 -0.03
		tcMod turb 0 0.05 0 0.125
	}
	{
		map $lightmap 
		blendfunc filter
		rgbGen identity
		tcGen lightmap 
	}
}

