# The ladder data is served only through index.php. Deny direct HTTP access
# to match files, profiles, ghosts and the key store (Apache; nginx: see README).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
